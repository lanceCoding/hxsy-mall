<view class='container'>
  <form bindsubmit="savePhone">

      <!--详细地址-->
      <view class="weui-cell weui-cell_input">
        <view class="weui-cell__hd">
          <view class="weui-label">称呼</view></view>
        <view class="weui-cell__bd">
          <input class="weui-input" name="name" placeholder="请设置称呼或姓名" value="{{user.nickName}}" />
        </view>
      </view>
      
       <!--手机号-->
       <view class="weui-cell weui-cell_input">
        <view class="weui-cell__hd">
          <view class="weui-label">手机号</view></view>
        <view class="weui-cell__bd">
          <input class="weui-input" name="phone" placeholder="请输入收货人手机号" value="{{user.phoneNumber}}"/></view>
      </view>
      <!--微信定位地址-->
      <!-- <view class="weui-cell weui-cell_input">
        <view class="weui-cell__hd">
          <view class="weui-label" >选择地址</view>
        </view>
        <view class="weui-cell__bd" bindtap='openChooseLocation'>
        {{address == ''?'点击选择地址':address}}
        </view>
      </view>      
     </view> -->
     <view class="btn">
        <button class="btn-p-m" form-type="submit">保存</button>
     </view>
    </form>
</view>