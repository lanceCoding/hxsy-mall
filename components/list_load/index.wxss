.list-container {
    width: 100%;
    font-size: var(--font-content);
    color: var(--ft-label);
  }
  
  .loading,
  .loading-more {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 10rpx;
  }
  
  .loading-icon {
    width: 30rpx;
    height: 30rpx;
    border: 4rpx solid rgba(0, 0, 0, 0.2);
    border-top-color: #007aff;
    border-radius: 50%;
    margin-right: 20rpx;
    animation: spin 1s linear infinite;
  }
  
  .empty-data {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 10rpx;
  }
  
  .data-loaded {
    width: 100%;
  }
  
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }